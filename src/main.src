// lume CLI entry point.

func main() {
    a := args()
    if len(a) < 2 {
        PrintUsage()
        exit(0)
    }
    cmd := a[1]

    if cmd == "init" {
        resInit := CmdInit()
        PrintJson(resInit)
        return
    }

    if cmd == "add" {
        if len(a) < 3 { Fatal("add requires path", 80) }
        resAdd := CmdAdd(a)
        PrintJson(resAdd)
        return
    }

    if cmd == "status" {
        resStatus := CmdStatus()
        PrintJson(resStatus)
        return
    }

    if cmd == "commit" {
        msg := ""
        i := 2
        while i < len(a) {
            if a[i] == "-m" && i+1 < len(a) {
                msg = a[i+1]
                i = i + 1
            } else if i == 2 {
                msg = a[i]
            }
            i = i + 1
        }
        if msg == "" { Fatal("commit requires message", 80) }
        resCommit := CmdCommit(msg)
        PrintJson(resCommit)
        return
    }

    if cmd == "log" {
        resLog := CmdLog()
        PrintJson(resLog)
        return
    }

    if cmd == "branch" {
        name := ""
        if len(a) > 2 { name = a[2] }
        resBranch := CmdBranch(name)
        PrintJson(resBranch)
        return
    }

    if cmd == "checkout" {
        if len(a) < 3 { Fatal("checkout requires branch or commit", 80) }
        resCheckout := CmdCheckout(a[2])
        PrintJson(resCheckout)
        return
    }

    if cmd == "show" {
        target := ""
        if len(a) > 2 { target = a[2] }
        resShow := CmdShow(target)
        PrintJson(resShow)
        return
    }

    if cmd == "cat-file" {
        if len(a) < 3 { Fatal("cat-file requires hash", 80) }
        obj := ReadObject(a[2])
        println(obj)
        return
    }

    if cmd == "hash-object" {
        if len(a) < 3 { Fatal("hash-object requires path", 80) }
        _, hash := BlobFromPath(a[2])
        println(hash)
        return
    }

    if cmd == "serve" {
        port := ""
        if len(a) > 2 { port = a[2] }
        CmdServe(port)
        return
    }

    if cmd == "push" {
        if len(a) < 3 { Fatal("push requires remote url", 80) }
        ref := ""
        if len(a) > 3 { ref = a[3] }
        resPush := CmdPush(a[2], ref)
        PrintJson(resPush)
        return
    }

    if cmd == "pull" {
        if len(a) < 3 { Fatal("pull requires remote url", 80) }
        ref := ""
        if len(a) > 3 { ref = a[3] }
        resPull := CmdPull(a[2], ref)
        PrintJson(resPull)
        return
    }

    if cmd == "clone" {
        if len(a) < 3 { Fatal("clone requires remote url", 80) }
        dir := ""
        ref := ""
        if len(a) > 3 { dir = a[3] }
        if len(a) > 4 { ref = a[4] }
        resClone := CmdClone(a[2], dir, ref)
        PrintJson(resClone)
        return
    }

    PrintUsage()
    exit(80)
}

func PrintUsage() {
    println("lume - a tiny agent-friendly git-like VCS")
    println("commands: init, add <path>, status, commit -m <msg>, log, branch [name], checkout <target>, show <target>")
    println("          cat-file <hash>, hash-object <path>")
    println("          serve [port], push <remote> [ref], pull <remote> [ref], clone <remote> [dir] [ref]")
}

func PrintJson(v) {
    println(json(v))
}

func Fatal(msg, code) {
    err := make(map[string]string)
    err["status"] = "error"
    err["message"] = msg
    println(json(err))
    exit(code)
}
